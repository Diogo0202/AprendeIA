# OpenAI: geração estruturada de questões e explicações.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase: credenciais exclusivas do servidor. Nunca enviar ao frontend.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Opcional: segredo exclusivo para anonimizar e-mail/IP no limite de login.
# Sem ele, o backend usa a chave secreta acima apenas como chave HMAC.
RATE_LIMIT_PEPPER=
# No Railway, informe a rede interna do proxy que entrega X-Real-IP.
# Deixe vazio quando o backend recebe a conexão diretamente.
TRUSTED_PROXY_CIDRS=

# Origem autorizada pelo middleware CORS.
FRONTEND_URL=http://localhost:5173
APP_ENV=development
LOG_LEVEL=INFO

# Turnstile: obrigatório quando a chave secreta está configurada.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# No ambiente produtivo, o Supabase Auth verifica cada token uma única vez.
TURNSTILE_VERIFICATION_MODE=supabase
TURNSTILE_REQUIRED=false

# SMTP: ficam somente no Railway ou no .env local, nunca em tabela ou no Git.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=aprendeia@escola.com
SMTP_USE_SSL=true

# Transporte de e-mail: smtp mantém a configuração padrão compatível.
# Para Resend defina EMAIL_TRANSPORT=resend, RESEND_API_KEY e EMAIL_FROM.
EMAIL_TRANSPORT=smtp
RESEND_API_KEY=
EMAIL_FROM=aprendeia@escola.com
EMAIL_PANEL_URL=https://seu-frontend.vercel.app

# Protege o job semanal. Gere um valor longo e aleatório no painel do Railway.
WEEKLY_SUMMARY_CRON_SECRET=

# A prévia não apaga contas. Não habilite execução antes de validar o executor.
ACCOUNT_RETENTION_CRON_SECRET=
ACCOUNT_RETENTION_ENABLED=false
