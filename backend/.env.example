# OpenAI: geração estruturada de questões e explicações.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase: credenciais exclusivas do servidor. Nunca enviar ao frontend.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=

# Origem autorizada pelo middleware CORS.
FRONTEND_URL=http://localhost:5173

# SMTP: ficam somente no Railway ou no .env local, nunca em tabela ou no Git.
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=aprendeia@escola.com
SMTP_USE_SSL=true

# Protege o job semanal. Gere um valor longo e aleatório no painel do Railway.
WEEKLY_SUMMARY_CRON_SECRET=
