# Credenciais publicáveis usadas pelo Supabase Auth no navegador.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_substitua_aqui

# Endereço público do backend FastAPI.
VITE_API_URL=http://localhost:8000

# O Clarity fica desligado por padrão porque o AprendeIA pode atender menores.
# Use apenas em um ambiente de teste com público adulto e consentimento informado.
VITE_ENABLE_CLARITY=false
VITE_CLARITY_PROJECT_ID=
