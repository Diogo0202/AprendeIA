{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 inicia a API e permite parar nos breakpoints do código Python.
      "name": "AprendeIA: depurar backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}\\backend",
      "envFile": "${workspaceFolder}\\backend\\.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // Esta opção sobe o Vite automaticamente antes de abrir o navegador.
      "name": "AprendeIA: depurar frontend",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}\\frontend",
      "preLaunchTask": "AprendeIA: frontend"
    }
  ],
  "compounds": [
    {
      // Com esta opção, um único F5 inicia API, site e depuração juntos.
      "name": "AprendeIA: aplicativo completo",
      "configurations": [
        "AprendeIA: depurar backend",
        "AprendeIA: depurar frontend"
      ],
      "stopAll": true
    }
  ]
}
