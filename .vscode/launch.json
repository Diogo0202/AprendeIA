{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 inicia a API e permite parar nos breakpoints do código Python.
      "name": "AprendeIA: depurar backend",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}\\backend",
      "envFile": "${workspaceFolder}\\backend\\.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      // Use esta opção depois de iniciar a tarefa do frontend.
      "name": "AprendeIA: depurar frontend",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}\\frontend"
    }
  ]
}
